rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function notChangingProtectedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'disabled']);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && notChangingProtectedFields()) || isAdmin();
      
      // FIXED: Allow admins to delete users
      allow delete: if isAdmin();

      match /{subcollection}/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // FIXED: Allow admins to query lessonHistory across all users (collection group query)
    match /{path=**}/lessonHistory/{docId} {
      allow read: if isAdmin();
    }

    // FIXED: Announcements permissions
    match /announcements/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // FIXED: Feedback permissions
    match /feedback/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // FIXED: Error logs permissions
    match /errorLogs/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /adminActions/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /sharedLessonContent/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                   && request.resource.data.keys().hasAll(['targetLanguage', 'level', 'skill', 'lessonIndex', 'exercises'])
                   && request.resource.data.targetLanguage is string
                   && request.resource.data.level is string
                   && request.resource.data.skill is string
                   && request.resource.data.lessonIndex is number
                   && request.resource.data.exercises is list
                   && request.resource.data.exercises.size() > 0;
      allow update, delete: if isAdmin();
    }

    // Units tab cache — used exclusively by units.js, never by lesson.js
    match /levels/{level}/units/{unitId}/lessons/{lessonId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                   && request.resource.data.keys().hasAll(['targetLanguage', 'level', 'unit', 'skill', 'exercises'])
                   && request.resource.data.targetLanguage is string
                   && request.resource.data.level is string
                   && request.resource.data.unit is string
                   && request.resource.data.skill is string
                   && request.resource.data.exercises is list
                   && request.resource.data.exercises.size() > 0;
      allow update, delete: if isAdmin();
    }

    // unitProgress field in /users/{uid} — written by units.js only
    // (reads/writes to the users doc are already covered by the /users/{uid} match above)

    // Weekly Leagues — cohort group collection
    match /leagueGroups/{groupId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Study Groups — public group discovery & membership collection
    match /studyGroups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                   && request.resource.data.keys().hasAll(['name', 'description', 'nativeLanguage', 'learningLanguage', 'createdBy', 'members', 'memberCount', 'isPublic'])
                   && request.resource.data.name is string
                   && request.resource.data.description is string
                   && request.resource.data.nativeLanguage is string
                   && request.resource.data.learningLanguage is string
                   && request.resource.data.createdBy == request.auth.uid
                   && request.resource.data.memberCount is number
                   && request.resource.data.memberCount <= 50;
      allow update: if isSignedIn()
                   && (
                     // Joining group (adding self if memberCount < 50)
                     (request.resource.data.memberCount <= 50 && request.resource.data.members.hasAll(resource.data.members))
                     // Leaving group (removing self)
                     || resource.data.members.removeAll(request.resource.data.members).hasOnly([request.auth.uid])
                     // Group creator or Admin editing
                     || resource.data.createdBy == request.auth.uid
                     || isAdmin()
                   );
      allow delete: if (isSignedIn() && resource.data.createdBy == request.auth.uid) || isAdmin();

      // Subcollection: Posts feed (member access required for read & create)
      match /posts/{postId} {
        allow read: if isSignedIn() 
                     && request.auth.uid in get(/databases/$(database)/documents/studyGroups/$(groupId)).data.members;
        allow create: if isSignedIn()
                     && request.auth.uid in get(/databases/$(database)/documents/studyGroups/$(groupId)).data.members
                     && request.resource.data.authorUid == request.auth.uid
                     && request.resource.data.text is string;
        allow update: if isSignedIn()
                     && request.auth.uid in get(/databases/$(database)/documents/studyGroups/$(groupId)).data.members;
        allow delete: if (isSignedIn() && resource.data.authorUid == request.auth.uid) || isAdmin();

        // Subcollection: Nested replies under posts
        match /replies/{replyId} {
          allow read: if isSignedIn() 
                       && request.auth.uid in get(/databases/$(database)/documents/studyGroups/$(groupId)).data.members;
          allow create: if isSignedIn()
                       && request.auth.uid in get(/databases/$(database)/documents/studyGroups/$(groupId)).data.members
                       && request.resource.data.authorUid == request.auth.uid
                       && request.resource.data.text is string;
          allow update: if isSignedIn()
                       && (resource.data.authorUid == request.auth.uid || isAdmin());
          allow delete: if (isSignedIn() && resource.data.authorUid == request.auth.uid) || isAdmin();
        }
      }
    }

    // Weekly Snapshots — historical end-of-week metrics
    match /weeklySnapshots/{snapshotId} {
      allow read: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}

{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**"
    ],
    "rewrites": [
      {
        "source": "/api/callGemini",
        "function": "callGemini"
      },
      {
        "source": "/api/callTextToSpeech",
        "function": "callTextToSpeech"
      },
      {
        "source": "/api/callSpeechToText",
        "function": "callSpeechToText"
      }
    ]
  }
}